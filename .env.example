# Copy file này thành .env rồi sửa. KHÔNG commit .env lên git.
APP_PROFILE=dev

APP_HOST=0.0.0.0
APP_PORT=8080

APP_DB_URL=jdbc:mysql://localhost:3306/lms?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC
APP_DB_USER=lms
APP_DB_PASSWORD=lms_dev_password

# Admin đầu tiên (chỉ tạo khi DB chưa có admin nào)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# true khi chạy HTTPS
APP_SECURE_COOKIE=false
# native: lấy IP máy người dùng qua gateway preview / reverse proxy chạy cùng máy
APP_FORWARD_HEADERS=native
# Ví dụ: http://192.168.1.10:3000 (để trống = chỉ same-origin)
APP_WS_ALLOWED_ORIGINS=

# Máy chấm bài lập trình: local (dev, không cô lập) / docker (mặc định ở prod; dựng image judge/Dockerfile).
# Không đặt thì theo profile.
# APP_JUDGE_SANDBOX=docker
# APP_JUDGE_WORKERS=2
